# =============================================================
# ravena-ai + whatsgoapi — Configurações de Ambiente
# =============================================================
# Defina apenas as variáveis que você precisar usar.
# Variáveis obrigatórias estão marcadas com [REQUIRED].
# =============================================================

# ─────────────────────────────────────────────────────────────
# GERAL — ravena-ai
# ─────────────────────────────────────────────────────────────
DEFAULT_PREFIX=!                        # Prefixo padrão de comandos
SAFE_MODE=false                         # true = apenas simula envio de mensagens (debug)
DEBUG=true                              # Mostra mensagens de debug mais detalhadas
DEBUG_RATE_LIMIT=false                  # true = monitora e registra chamadas e erros 429/rate-overlimit em SQLite
GROUP_CACHE_TTL_SEC=60                  # TTL em segundos para cache de metadados de grupos (padrão: 60)
USER_CACHE_TTL_SEC=60                   # TTL em segundos para cache de dados de contatos (padrão: 60)
DL_FOLDER=/mnt/downloads                # [REQUIRED] Caminho no HOST para downloads (YouTube, etc)
                                        #   Este caminho é montado como volume dentro do container.
                                        #   Use uma pasta com bastante espaço livre (ex: HD externo montado).
LOVECELL_STICKERS_FOLDER=/mnt/stickers  # [OPTIONAL] Caminho no HOST para figurinhas lovecell (ex: HD secundário)
                                        #   Se não definido, usa o subdiretório padrão ./data/media/lovecell.
NODE_OPTIONS=--max-old-space-size=4096  # Limite de memória heap do Node.js
FFMPEG_PATH=/usr/bin/ffmpeg             # Caminho do ffmpeg dentro do container (não altere em Docker)

NOTIFY_UNKNOWN_COMMANDS=false           # Responder mensagens de "comando não encontrado"
CMD_DEBOUNCE=3000                       # Tempo mínimo em ms entre cada comando
DEBOUNCE_BAN=10                         # Limite de tentativas de bypass do debounce antes do banimento por 1 hora
DEBOUNCE_DECAY=60                       # Tempo em segundos para decaimento de 1 tentativa no bypass count
SUPER_ADMINS=12345@c.us                 # [REQUIRED] Número(s) com permissões de SuperAdmin (padrão ID do WhatsApp)
LOADING_EMOJI=⌛️                        # Emoji de carregamento (nem todos são suportados)
CMD_WHITELIST=sa-,anoni                 # Comandos considerados mesmo com "ignorar PV" habilitado
DISABLE_DOWNLOADS=false                 # true = desabilita os comandos de download (Youtube/Redes Sociais)


# ─────────────────────────────────────────────────────────────
# API — ravena-ai (BotAPI / Gerenciamento Web)
# ─────────────────────────────────────────────────────────────
API_PORT=5000                           # Porta exposta ao host — acesse via localhost:5000 ou <IP-da-máquina>:5000
BOT_DOMAIN=https://seuhost.com/rv       # URL pública da API (usada em links externos, opcional)
BOT_DOMAIN_LOCAL=http://ravena-ai:5000  # URL interna — já configurado para Docker, não altere
BOTAPI_USER=admin                       # Usuário para comandos remotos via API
BOTAPI_PASSWORD=senhaSecreta            # Senha para comandos remotos via API
MANAGEMENT_TOKEN_DURATION=30            # Duração em minutos da sessão do painel !g-painel
LIMIT_STORAGE_MB=1024                   # Limite de armazenamento de mídia por grupo (MB)
LIMIT_COMMANDS=100                      # Limite de comandos personalizados por grupo
LIMIT_STREAMS=20                        # Limite de streams monitoradas por grupo
UPS_API_SECRET=uma_senha_muito_segura   # Segredo para autenticar webhooks do nobreak (UPS)
GROUP_WEBHOOKS=                         # Habilita webhooks por grupo
GROUP_WEBHOOKS_DOMAIN=                  # Domínio para os webhooks de grupo

# Comunicação interna com whatsgoapi (não altere em Docker)
WHATS_GO_API_URL=http://whatsgoapi:8080     # URL interna da API whatsgoapi
WHATS_GO_API_KEY=SUA_GLOBAL_API_KEY         # [REQUIRED] Deve ser igual ao GLOBAL_API_KEY abaixo
WHATSGO_WEBHOOK_HOST=ravena-ai             # Hostname do ravena-ai na rede Docker (não altere)
WHATSGO_WEBHOOK_PORT=5000                  # Porta do webhook recebida pelo ravena-ai (não altere)

# rembg — remoção de fundo (interno Docker)
REMBG_API_URL=http://rembg:7000/api/remove  # URL interna do serviço rembg (não altere em Docker)

# Copa do Mundo 2026 API
WDC2026_API_URL=https://worldcup26.ir/  # URL da API da Copa 2026 (https://github.com/rezarahiminia/worldcup2026)

# ─────────────────────────────────────────────────────────────
# GRUPOS DO WHATSAPP — IDs de grupos para notificações
# Nenhuma dessas variáveis é obrigatória para o bot funcionar
# ─────────────────────────────────────────────────────────────
GRUPO_LOGS=1234678901234567890@g.us     # ID do grupo para debug e monitoramento
GRUPO_ESTABILIDADE=1234678901234567890  # ID do grupo de estabilidade
GRUPO_INVITES=1234678901234567890@g.us  # ID do grupo de invites
DISABLE_INVITE_AUTO_ACCEPT=false        # true = desativa o auto-aceite de convites via LLM (todos vão para aprovação manual)
RECENTLY_BANNED=false                   # true = modo de reposição de ravena banida (apenas grupos com bot banido ou doadores)
GRUPO_AVISOS=1234678901234567890@g.us   # ID do grupo de avisos
GRUPO_ANUNCIOS=1234678901234567890@g.us # ID do grupo de anúncios
GRUPO_INTERACAO=1234678901234567890@g.us# ID do grupo de interação
LINK_GRUPO_INTERACAO=https://chat.whatsapp.com/abc123 # Link para o !grupao
LINK_GRUPO_AVISOS=https://chat.whatsapp.com/def456    # Link para o !avisos
GRUPOS_SKIP_BAN=                         # Grupos oficiais protegidos (separados por vírgula): bot nunca sai e membros nunca são banidos em massa
GRUPO_PESCA=                            # Grupo para remoção de spam (pesca)
GRUPO_DOWNLOADS=                        # Grupo para downloads
GRUPOS_HOROSCOPOS=                      # Grupos para horóscopo
GRUPO_MUNEWS=                           # Grupo de notícias

# ─────────────────────────────────────────────────────────────
# DISCORD
# ─────────────────────────────────────────────────────────────
GRUPO_LOGS_DISCORD=                     # ID do canal Discord para logs
GRUPO_AVISOS_DISCORD=                   # ID do canal Discord para avisos
DISCORD_INVITE_LINK=
DISCORD_COMMUNITY=https://discord.gg/39aAwUFRt

# ─────────────────────────────────────────────────────────────
# TELEGRAM
# ─────────────────────────────────────────────────────────────
TELEGRAM_WEBHOOK_PORT=9005
TELEGRAM_GRUPO_LOGS=                    # ID do chat Telegram para logs
TELEGRAM_GRUPO_AVISOS=                  # ID do chat Telegram para avisos
TELEGRAM_INVITE_LINK=https://t.me/ravenosabot
TELEGRAM_COMMUNITY=https://t.me/+x242TMlPD4s2OTVh

# ─────────────────────────────────────────────────────────────
# BANCO DE DADOS / BACKUP
# ─────────────────────────────────────────────────────────────
MAX_BACKUPS=120                         # Quantidade máxima de backups locais a manter
BACKUP_RETENTION_DAYS=30                # Dias para manter os backups locais
SCHEDULED_BACKUP_HOURS=0,6,12,18        # Horas do dia para backup automático
BACKUP_GZIP=false                       # true = compacta cada .db do backup em .db.gz (restauração aceita os dois)
SQLITE_JOURNAL_MODE=WAL                 # WAL (padrão, mais rápido) ou DELETE (modo antigo, synchronous=FULL)
SQLITE_REMOTE_BACKUP=false              # Ativa backup remoto em servidores SQL (MySQL/Postgres)
SQLITE_REMOTE_SERVERS=mysql://user:pass@host:port/db # DSNs dos servidores de backup remoto
REMOTE_BACKUP_INTERVAL_MINUTES=30       # Intervalo de sincronização remota (em minutos)

# ─────────────────────────────────────────────────────────────
# REDIS (CACHE)
# Já configurado para Docker. Altere apenas para usar um Redis externo.
# ─────────────────────────────────────────────────────────────
USE_REDIS=false                         # Ativa cache via Redis
CACHE_REDIS_URI=redis://redis:6379      # URI do servidor Redis — já configurado para Docker
CACHE_REDIS_TTL=3600                    # TTL padrão do cache (segundos)

# ─────────────────────────────────────────────────────────────
# RAGNAROK (banco de dados do jogo, opcional)
# ─────────────────────────────────────────────────────────────
RAGNAROK_URL=
RAGNAROK_HOST=
RAGNAROK_USER=
RAGNAROK_PASSWORD=
RAGNAROK_DATABASE=

# ─────────────────────────────────────────────────────────────
# APIs EXTERNAS — Redes Sociais e Streaming
# ─────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=                       # https://dev.twitch.tv/docs/api/
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=                         # https://docs.kick.com/getting-started/kick-apps-setup
KICK_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=                   # Pegar da aba network no navegador
SOUNDCLOUD_OAUTH_TOKEN=                 # Pegar da aba network no navegador

# ─────────────────────────────────────────────────────────────
# APIs EXTERNAS — IA / LLM
# ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=                         # https://ai.google.dev/ + https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=                    # ⚠️ CUIDADO: PAGO ⚠️ Habilite: Map Static API, Places API, Street View Static API
GEMINI_API_KEY=                         # https://aistudio.google.com/api-keys
DEEPSEEK_API_KEY=                       # https://platform.deepseek.com/apiKeys
OPENAI_API_KEY=                         # https://openai.com/api/
OPENROUTER_API_KEY=                     # https://openrouter.ai/keys
JINA_API_KEY=                           # https://jina.ai/ (Reader e Search)

# Anything LLM (instância self-hosted)
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_HOST=
ANYTHINGLLM_WORKSPACE=

# ─────────────────────────────────────────────────────────────
# APIs EXTERNAS — Outros serviços
# ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=                    # https://openweathermap.org/api
RIOT_GAMES=                             # https://developer.riotgames.com/
GIPHY_API_KEY=                          # https://developers.giphy.com/
DEEPL_API_KEY=                          # https://www.deepl.com/pro-api (Opcional - Chave da API DeepL)
OMDB_API_KEY=                           # https://www.omdbapi.com/apikey.aspx
UNSPLASH_API_KEY=                       # https://unsplash.com/developers
LASTFM_APIKEY=                          # https://www.last.fm/pt/api
LASTFM_SECRET=
NASA_API=                               # https://api.nasa.gov/
API_PLACAS_COMUM=                       # https://apiplacas.com.br/
API_PLACAS_PREMIUM=                     # https://apiplacas.com.br/
GRUPOS_PLACA_PREMIUM=                   # Nomes de grupos que podem usar a API placa premium
#API_PLACAS_USAR_PREMIUM=TRUE           # Descomente caso tenha chave premium
FIPE_API_TOKEN=                         # https://fipe.online/ (Token [X-Subscription-Token])
CORREIOS_API=                           # API custom para rastreamento dos correios

# ─────────────────────────────────────────────────────────────
# APIs AUTO-HOSPEDADAS (Stable Diffusion, Whisper, etc)
# Os URLs de APIs (Whisper, ComfyUI, etc) são configurados em service-providers.json
# ─────────────────────────────────────────────────────────────
API_TIMEOUT=30000                       # Timeout para chamadas de API externas (ms)
SDWEBUI_TOKEN=                          # base64 de user:password de --api-auth do SD WebUI
SD_width=1200
SD_height=1200
SD_steps=40
SD_cfg_scale=2
SD_sampler_name=k_dpmpp_2m_sde
DISABLE_IMAGINE_COMMAND=false           # true = desativa o comando !imagine
DISABLE_TTS_COMMAND=false               # true = desativa o comando TTS

# Outros endpoints auto-hospedados
PSNCOMMAND_API_URL=
STEAMCOMMAND_API_URL=
API_KEY_STEAMCOMMAND=
SIPT_URL=
SIPT_TOKEN=
NSFW_PREDICT_COMMAND=
NSFW_PREDICT_MODEL=
# NUDENET_THRESHOLD=0.8
# NUDENET_DEBUG=false
POWER_OUTAGE_MIN_TIME=5                 # Tempo mínimo de queda de energia para notificar (segundos)

# ─────────────────────────────────────────────────────────────
# TIPA (Doações)
# ─────────────────────────────────────────────────────────────
TIPA_TOKEN=                             # https://tipa.ai/settings/apps (WEBHOOKS)
DONATION_LINK=https://tipa.ai/moothz
DONATION_GOAL_AMOUNT=1000
DONATION_GOAL_DESCRIPTION=Pagar o servidor!

# =============================================================
# WHATSGOAPI — Configurações do backend Go (whatsmeow)
# =============================================================

# ─────────────────────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────────────────────
SERVER_PORT=8080                        # Porta INTERNA em que o whatsgoapi escuta
WHATSGOAPI_PORT=9800                    # Porta EXPOSTA ao host — acesse via localhost:9800

# ─────────────────────────────────────────────────────────────
# BANCO DE DADOS — whatsgoapi
# ⚠ Estes valores são usados para CRIAR o banco na primeira execução.
#   Após criado, não altere sem recriar o volume (docker compose down -v).
#   Use POSTGRES_USERS_DB (DSN completo) OU as variáveis separadas abaixo.
# ─────────────────────────────────────────────────────────────
POSTGRES_USERS_DB=                      # DSN completo (opcional): postgresql://user:pass@host:5432/db?sslmode=disable
POSTGRES_HOST=postgres                  # Host do PostgreSQL (não altere em Docker)
POSTGRES_PORT=5432                      # Porta do PostgreSQL
POSTGRES_USER=whatsgo                   # Usuário do PostgreSQL — usado na criação do banco
POSTGRES_PASSWORD=whatsgo_password      # Senha do PostgreSQL — gerada automaticamente pelo 'make setup'
POSTGRES_DB=whatsgo_db                  # Nome do banco de dados — criado automaticamente
POSTGRES_AUTH_DB=                       # DSN do banco de autenticação (opcional, usa SQLite se vazio)
DATABASE_SAVE_MESSAGES=false            # true = salva mensagens no banco de dados

# ─────────────────────────────────────────────────────────────
# AUTENTICAÇÃO — whatsgoapi
# ─────────────────────────────────────────────────────────────
GLOBAL_API_KEY=SUA_GLOBAL_API_KEY       # [REQUIRED] Gerada automaticamente pelo 'make setup'. Compartilhada entre ravena-ai e whatsgoapi.

# ─────────────────────────────────────────────────────────────
# COMPORTAMENTO — whatsgoapi
# ─────────────────────────────────────────────────────────────
CLIENT_NAME=ravenawhats                 # Nome do cliente WhatsApp
OS_NAME=Ravena WhatsGo                  # Nome do sistema operacional reportado ao WhatsApp
CONNECT_ON_STARTUP=true                 # true = conecta instâncias salvas na inicialização
WEBHOOK_URL=""                          # URL global de webhook (deixe vazio para usar webhooks por instância)
WEBHOOK_FILES=false                      # false = desativa download síncrono de todas as mídias no webhook (Ravena baixa sob demanda)
LOG_LEVEL=INFO                           # Nível de log da whatsgoapi: DEBUG, INFO, WARN, ERROR
LOG_MESSAGE_DETAILS=false                # false = logs compactos de mensagens; true = loga payload completo
LOG_SUMMARY_INTERVAL_SEC=15              # Intervalo em segundos para resumo periódico de mensagens recebidas e webhooks (0 = desativado)
FETCH_GROUP_INFO_ON_MESSAGE=false        # false = NÃO consulta GetGroupInfo no WhatsApp a cada mensagem recebida (evita gargalo)
GROUP_INFO_CACHE_TTL_MIN=30              # TTL em minutos do cache em memória para GetGroupInfo
WADEBUG=                                # Nível de debug do whatsmeow (DEBUG, INFO, WARN, ERROR)
LOGTYPE=console                         # Tipo de log: console ou file

# ─────────────────────────────────────────────────────────────
# STORAGE S3 — mídia da whatsgoapi (RustFS no docker-compose)
# Compatível com RustFS, SeaweedFS, Garage, AWS S3, Cloudflare R2…
# As variáveis MINIO_* ainda são aceitas como fallback para retrocompatibilidade
# com a whatsgoapi (cliente minio-go), mas S3_* tem prioridade.
# ─────────────────────────────────────────────────────────────
S3_ENABLED=true                         # true = usa o storage S3 para mídia
S3_ENDPOINT=rustfs:9000                 # host:porta do storage (não altere em Docker)
S3_ACCESS_KEY=ravenaadmin               # Access key do storage
S3_SECRET_KEY=storage_password          # Secret key do storage — gerada automaticamente pelo 'make setup'
S3_BUCKET=zap-media                     # Nome do bucket padrão para mídia
S3_BUCKET_DOWNLOADS=downloads            # Nome do bucket para downloads pesados (HD secundário)
S3_BUCKET_BACKUPS=backups                # Nome do bucket para snapshots SQLite (HD secundário)
S3_DOWNLOADS_PATH=./data/s3-downloads    # Caminho do host mapeado para o bucket downloads (ex: /mnt/hd/downloads)
S3_BACKUPS_PATH=./data/s3-backups        # Caminho do host mapeado para o bucket backups (ex: /mnt/hd/backups)
S3_PUBLIC_DOMAIN=https://s3-ravena.moothz.win # Domínio público do S3 para links e Presigned URLs
S3_PRESIGNED_EXPIRES_IN=21600            # Duração dos links assinados em segundos (6 horas)
S3_DOWNLOADS_RETENTION_HOURS=48          # Retenção de downloads temporários no HD secundário em horas
S3_BACKUPS_RETENTION_DAYS=30             # Retenção de backups diários no HD secundário em dias
S3_USE_SSL=false                        # true = conexão HTTPS com o storage
S3_REGION=                             # Região S3 (opcional; ex: "auto" no R2/Railway Bucket)
S3_RETENTION_DAYS=7                     # Dias para manter arquivos (lifecycle S3; 0 = desativado)
S3_STORAGE_LIMIT_GB=0                   # Quota não existe na API S3: configure no próprio storage

# ─────────────────────────────────────────────────────────────
# LOGS — whatsgoapi
# ─────────────────────────────────────────────────────────────
LOG_MAX_SIZE=100                        # Tamanho máximo do arquivo de log (MB)
LOG_MAX_BACKUPS=5                       # Número máximo de backups de log
LOG_MAX_AGE=30                          # Dias para manter logs
LOG_DIRECTORY=./logs                    # Diretório de logs
LOG_COMPRESS=true                       # true = comprime logs antigos

# =============================================================
# HEALTH CHECK — Script de monitoramento
# =============================================================
# Usado pelo container health-check para enviar notificações via Telegram
# quando o bot ou a API reiniciam/caem.
HEALTH_CHECK_TELEGRAM_BOT_TOKEN=        # Token do bot Telegram para notificações de saúde
HEALTH_CHECK_TELEGRAM_CHAT_ID=          # Chat ID do Telegram para receber as notificações


# =============================================================
# COBALT — Media Downloader
# =============================================================
COBALT_PORT=9090                        # Porta do Cobalt (usada no docker-compose)
COBALT_API_URL=http://cobalt:9000       # URL para o bot acessar a API (cobalt:9000 se no docker, localhost:9090 se fora)
COBALT_EXTERNAL_URL=http://localhost:9090 # URL para o bot baixar o arquivo (se rodando fora do docker)


# =============================================================
# MÚSICA & LETRAS
# =============================================================
# MUSICA_FOLDER=./downloads/musica      # Opcional: Pasta específica para músicas


# YouTube Downloader
YT_USE_COOKIES=false

# Timeout padrão (ms) do axios para chamadas HTTP sem timeout próprio (inatividade do socket)
HTTP_DEFAULT_TIMEOUT_MS=60000

# Configuração dos bots sem arquivo (ex: containers/PaaS). Só é usada se o bots.json NÃO existir.
# Mesmo formato do bots.json, em uma linha:
# BOTS_JSON=[{"enabled":true,"id":"ravena","platform":"whatsgo"}]

# =============================================================
# WAIFULETES — Roleta de Waifus (Mudae)
# =============================================================
WAIFULETES_API_URL=http://host.docker.internal:3030 # URL da API do Waifuletes
WAIFULETES_API_KEY=                                  # Token de autenticação da API

# =============================================================
# JARDIM DAS SOMBRAS — Minigame de Fazenda Gótica
# =============================================================
JARDIM_API_URL=http://host.docker.internal:3040     # URL da API do Jardim das Sombras
JARDIM_API_KEY=jardim_secret_api_key_2026           # Chave secreta da API da Fazenda

# =============================================================
# AVIAÇÃO E RASTREAMENTO DE VÔOS (Opcionais)
# =============================================================
# O bot já possui rastreamento ADS-B ao vivo (adsb.lol + OpenSky), ANAC RAB oficial,
# hexdb.io e METAR (aviationweather.gov) gratuitos e funcionando sem necessidade de chaves.
# As chaves abaixo são opcionais e habilitam recursos adicionais:
AISWEB_API_KEY=                         # Chave da API AISWEB (DECEA/FAB - aisweb.decea.mil.br)
AISWEB_API_PASS=                        # Senha da API AISWEB (DECEA/FAB)
AIRLABS_API_KEY=                        # Chave AirLabs (airlabs.co - painéis de partidas/chegadas)
AVIATIONSTACK_API_KEY=                  # Chave AviationStack (aviationstack.com)

