# =============================================================
# ravena-ai + whatsgoapi — Configurações de Ambiente
# =============================================================
# Defina apenas as variáveis que você precisar usar.
# Variáveis obrigatórias estão marcadas com [REQUIRED].
# =============================================================


# =============================================================
# 1. GERAL, COMPORTAMENTO E RUNTIME (ravena-ai)
# =============================================================

# ─────────────────────────────────────────────────────────────
# 1.1 Execução, Prefixo e Logs
# ─────────────────────────────────────────────────────────────
DEFAULT_PREFIX=!                        # Prefixo padrão de comandos
SAFE_MODE=false                         # true = apenas simula envio de mensagens (debug)
DEBUG=true                              # Mostra mensagens de debug mais detalhadas
DEBUG_RATE_LIMIT=false                  # true = monitora e registra chamadas e erros 429/rate-overlimit em SQLite
NOTIFY_UNKNOWN_COMMANDS=false           # Responder mensagens de "comando não encontrado"
LOADING_EMOJI=⌛️                        # Emoji de carregamento (nem todos são suportados)
# TZ=America/Sao_Paulo                  # Fuso horário padrão para variáveis e comandos de data/hora

# ─────────────────────────────────────────────────────────────
# 1.2 Permissões e Anti-Spam (Debounce)
# ─────────────────────────────────────────────────────────────
SUPER_ADMINS=12345@c.us                 # [REQUIRED] Número(s) com permissões de SuperAdmin (separados por vírgula)
CMD_WHITELIST=sa-,anoni                 # Comandos considerados mesmo com "ignorar PV" habilitado
CMD_DEBOUNCE=3000                       # Tempo mínimo em ms entre cada comando
DEBOUNCE_BAN=10                         # Limite de tentativas de bypass do debounce antes do banimento por 1 hora
DEBOUNCE_DECAY=60                       # Tempo em segundos para decaimento de 1 tentativa no bypass count

# ─────────────────────────────────────────────────────────────
# 1.3 Flags de Recursos e Convites
# ─────────────────────────────────────────────────────────────
DISABLE_DOWNLOADS=false                 # true = desabilita os comandos de download (YouTube/Redes Sociais)
DISABLE_IMAGINE_COMMAND=false           # true = desativa o comando !imagine
DISABLE_TTS_COMMAND=false               # true = desativa os comandos de TTS (síntese de voz)
DISABLE_INVITE_AUTO_ACCEPT=false        # true = desativa o auto-aceite de convites via LLM (todos vão para aprovação manual)
RECENTLY_BANNED=false                   # true = modo de reposição de ravena banida (apenas grupos com bot banido ou doadores)

# ─────────────────────────────────────────────────────────────
# 1.4 Runtime, Rede, Pastas e Cache de Entidades
# ─────────────────────────────────────────────────────────────
NODE_OPTIONS=--max-old-space-size=4096  # Limite de memória heap do Node.js
FFMPEG_PATH=/usr/bin/ffmpeg             # Caminho do ffmpeg dentro do container (não altere em Docker)
HTTP_DEFAULT_TIMEOUT_MS=60000           # Timeout padrão (ms) do axios para chamadas HTTP sem timeout próprio
DL_FOLDER=/mnt/downloads                # [REQUIRED] Caminho no HOST para downloads (YouTube, etc)
                                        #   Este caminho é montado como volume dentro do container (/app/downloads).
                                        #   Use uma pasta com bastante espaço livre (ex: HD externo montado).
LOVECELL_STICKERS_FOLDER=/mnt/stickers  # [OPTIONAL] Caminho no HOST para figurinhas lovecell (ex: HD secundário)
                                        #   Mapeado para /app/data/media/lovecell no Docker.
GROUP_CACHE_TTL_SEC=60                  # TTL em segundos para cache de metadados de grupos (padrão: 60)
USER_CACHE_TTL_SEC=60                   # TTL em segundos para cache de dados de contatos (padrão: 60)
# USER_AGENT=                           # User-Agent customizado opcional para requisições do bot
# BOTS_JSON=[{"enabled":true,"id":"ravena","platform":"whatsgo"}] # Configuração sem arquivo (usada apenas se bots.json não existir)
# STICKER_SCRAPER_MIN_INTERVAL=400      # Intervalo mínimo (ms) entre coletas do StickerScraper
# STICKER_SCRAPER_MAX_INTERVAL=6000     # Intervalo máximo (ms) entre coletas do StickerScraper
# STICKER_SCRAPER_BACKOFF_INTERVAL=900000 # Tempo de backoff (ms) do StickerScraper
# PROFILE_STATUS_STAGGER_INTERVAL=      # Intervalo (ms) de escalonamento para atualização de recado/status de perfil
# RAFFLE_POLL_INTERVAL_MS=              # Intervalo de polling (ms) do monitor de rifas


# =============================================================
# 2. API WEB, PAINEL E COMUNICAÇÃO INTERNA (BotAPI)
# =============================================================

# ─────────────────────────────────────────────────────────────
# 2.1 Servidor e Domínios
# ─────────────────────────────────────────────────────────────
API_PORT=5000                           # Porta exposta ao host — acesse via localhost:5000 ou <IP-da-máquina>:5000
BOT_DOMAIN=https://seuhost.com/rv       # URL pública da API (usada em links externos, painel web, etc)
BOT_DOMAIN_LOCAL=http://ravena-ai:5000  # URL interna — já configurado para Docker

# ─────────────────────────────────────────────────────────────
# 2.2 Autenticação e Limites do Painel (!g-painel)
# ─────────────────────────────────────────────────────────────
BOTAPI_USER=admin                       # Usuário para comandos remotos e painel via API
BOTAPI_PASSWORD=senhaSecreta            # Senha para comandos remotos e painel via API
MANAGEMENT_TOKEN_DURATION=30            # Duração em minutos da sessão do painel !g-painel
LIMIT_STORAGE_MB=1024                   # Limite de armazenamento de mídia por grupo (MB)
LIMIT_COMMANDS=100                      # Limite de comandos personalizados por grupo
LIMIT_STREAMS=20                        # Limite de streams monitoradas por grupo

# ─────────────────────────────────────────────────────────────
# 2.3 Webhooks de Grupos e Nobreak (UPS)
# ─────────────────────────────────────────────────────────────
GROUP_WEBHOOKS=                         # Porta para habilitar webhooks por grupo (vazio = desativado)
GROUP_WEBHOOKS_DOMAIN=                  # Domínio público para os webhooks de grupo
UPS_API_SECRET=uma_senha_muito_segura   # Segredo para autenticar webhooks do nobreak (UPS)
POWER_OUTAGE_MIN_TIME=5                 # Tempo mínimo de queda de energia para notificar (segundos)

# ─────────────────────────────────────────────────────────────
# 2.4 Comunicação Interna com whatsgoapi (não altere em Docker)
# ─────────────────────────────────────────────────────────────
WHATS_GO_API_URL=http://whatsgoapi:8080 # URL interna da API whatsgoapi
WHATS_GO_API_KEY=SUA_GLOBAL_API_KEY     # [REQUIRED] Deve ser igual ao GLOBAL_API_KEY da seção WHATSGOAPI
WHATSGO_WEBHOOK_HOST=ravena-ai          # Hostname do ravena-ai na rede Docker (não altere)
WHATSGO_WEBHOOK_PORT=5000               # Porta base de webhook recebida pelo ravena-ai


# =============================================================
# 3. PLATAFORMAS E CANAIS OFICIAIS (WhatsApp, Discord, Telegram)
# Nenhuma dessas variáveis é obrigatória para o bot funcionar
# =============================================================

# ─────────────────────────────────────────────────────────────
# 3.1 WhatsApp — IDs de Grupos e Links Oficiais
# ─────────────────────────────────────────────────────────────
GRUPO_LOGS=1234678901234567890@g.us     # ID do grupo para debug e monitoramento
GRUPO_DOSSIES=                          # ID do grupo para envio de dossiês (se vazio, usa GRUPO_LOGS)
GRUPO_ESTABILIDADE=1234678901234567890  # ID do grupo de estabilidade
GRUPO_INVITES=1234678901234567890@g.us  # ID do grupo de invites
GRUPO_AVISOS=1234678901234567890@g.us   # ID do grupo/canal de avisos
GRUPO_ANUNCIOS=1234678901234567890@g.us # ID do grupo de anúncios
GRUPO_INTERACAO=1234678901234567890@g.us# ID do grupo de interação (!grupao)
GRUPO_PESCA=                            # ID do grupo oficial de pesca
GRUPO_DOWNLOADS=                        # ID do grupo oficial para downloads
GRUPO_STICKERS=                         # ID do grupo oficial de figurinhas
GRUPOS_HOROSCOPOS=                      # IDs de grupos para horóscopo (separados por vírgula)
GRUPO_MUNEWS=                           # ID do grupo de notícias (MuNews)
GRUPOS_SKIP_BAN=                        # Grupos oficiais protegidos (separados por vírgula): bot nunca sai e membros nunca são banidos em massa
LINK_GRUPO_INTERACAO=https://chat.whatsapp.com/abc123 # Link para o !grupao
LINK_GRUPO_AVISOS=https://chat.whatsapp.com/def456    # Link para o !avisos
LINK_COMUNIDADE=                        # Link geral da comunidade usado no sistema de convites

# ─────────────────────────────────────────────────────────────
# 3.2 Discord
# ─────────────────────────────────────────────────────────────
GRUPO_LOGS_DISCORD=                     # ID do canal Discord para logs
GRUPO_DOSSIES_DISCORD=                  # ID do canal Discord para dossiês (se vazio, usa GRUPO_LOGS_DISCORD)
GRUPO_AVISOS_DISCORD=                   # ID do canal Discord para avisos
DISCORD_INVITE_LINK=                    # Link OAuth2 para adicionar o bot no Discord
DISCORD_COMMUNITY=https://discord.gg/39aAwUFRt # Link do servidor oficial no Discord
# DISCORD_DEBUG=false                   # Logs detalhados da API HTTP do Discord
# DISCORD_DEBUG_EVENTS=false            # Logs detalhados de eventos Gateway do Discord

# ─────────────────────────────────────────────────────────────
# 3.3 Telegram
# ─────────────────────────────────────────────────────────────
TELEGRAM_WEBHOOK_PORT=9005              # Porta para webhooks do Telegram
TELEGRAM_GRUPO_LOGS=                    # ID do chat Telegram para logs
TELEGRAM_GRUPO_DOSSIES=                 # ID do chat Telegram para dossiês (se vazio, usa TELEGRAM_GRUPO_LOGS)
TELEGRAM_GRUPO_AVISOS=                  # ID do chat Telegram para avisos
TELEGRAM_INVITE_LINK=https://t.me/ravenosabot # Link do bot no Telegram
TELEGRAM_COMMUNITY=https://t.me/+x242TMlPD4s2OTVh # Link do grupo da comunidade no Telegram


# =============================================================
# 4. BANCO DE DADOS (SQLite), CACHE (Redis) E BACKUPS
# =============================================================

# ─────────────────────────────────────────────────────────────
# 4.1 SQLite e Backups
# ─────────────────────────────────────────────────────────────
SQLITE_JOURNAL_MODE=WAL                 # WAL (padrão, mais rápido) ou DELETE (modo antigo, synchronous=FULL)
BACKUP_TO_FS=false                      # false = zero escritas locais em data/backups (usa apenas S3)
BACKUP_TO_S3=true                       # true = envia snapshots SQLite para o bucket de backups no S3
PRIMARY_BACKUP_PATH=/app/downloads/backups/sqlite # Caminho primário para backups em disco (se BACKUP_TO_FS=true)
# SECONDARY_BACKUP_PATH=                # Caminho secundário opcional para espelhamento de snapshots em disco
MAX_BACKUPS=120                         # Quantidade máxima de backups locais a manter
BACKUP_RETENTION_DAYS=30                # Dias para manter os backups locais
SCHEDULED_BACKUP_HOURS=0,6,12,18        # Horas do dia para backup automático
BACKUP_GZIP=false                       # true = compacta cada .db do backup em .db.gz (restauração aceita os dois)
SQLITE_REMOTE_BACKUP=false              # Ativa backup remoto em servidores SQL (MySQL/Postgres)
SQLITE_REMOTE_SERVERS=mysql://user:pass@host:port/db # DSNs dos servidores de backup remoto (separados por vírgula)
REMOTE_BACKUP_INTERVAL_MINUTES=30       # Intervalo de sincronização remota (em minutos)

# ─────────────────────────────────────────────────────────────
# 4.2 Redis (Cache)
# ─────────────────────────────────────────────────────────────
USE_REDIS=false                         # Ativa cache via Redis
CACHE_REDIS_URI=redis://redis:6379      # URI do servidor Redis
CACHE_REDIS_TTL=3600                    # TTL padrão do cache (segundos)


# =============================================================
# 5. STORAGE S3, ENCURTADOR (Sink) E RETENÇÃO DE MÍDIAS
# Compatível com RustFS (docker-compose), MinIO, SeaweedFS, Garage, AWS S3, Cloudflare R2…
# =============================================================

# ─────────────────────────────────────────────────────────────
# 5.1 Conexão e Buckets S3
# ─────────────────────────────────────────────────────────────
RUSTFS_DATA_PATH=./data/rustfs          # Caminho no host para dados do RustFS (no servidor pode ser SSD secundário: /mnt/ks500gb/rustfs-data)
SECONDARY_STORAGE_PATH=./data           # Caminho no host para disco secundário a monitorar no health-check (no servidor: /mnt/ks500gb)
S3_ENABLED=true                         # true = usa o storage S3 para mídia e backups
S3_ENDPOINT=minio:9000                  # host:porta do storage no Docker
S3_ACCESS_KEY=ravenaadmin               # Access key do storage
S3_SECRET_KEY=storage_password          # Secret key do storage — gerada automaticamente pelo 'make setup'
S3_USE_SSL=false                        # true = conexão HTTPS com o storage
S3_REGION=us-east-1                     # Região S3 (opcional; ex: "auto" no R2/Railway Bucket)
S3_BUCKET_MEDIA=zap-media               # Nome do bucket padrão para mídia
S3_BUCKET_DOWNLOADS=downloads           # Nome do bucket para downloads pesados
S3_BUCKET_BACKUPS=backups               # Nome do bucket para snapshots SQLite

# ─────────────────────────────────────────────────────────────
# 5.2 Domínio Público e Encurtador de Links (Sink)
# ─────────────────────────────────────────────────────────────
S3_PUBLIC_DOMAIN=https://s3-ravena.moothz.win # Domínio público do S3 para links e Presigned URLs
S3_PRESIGNED_EXPIRES_IN=21600           # Duração dos links assinados em segundos (6 horas)
SINK_URL=https://s.moothz.win           # URL base do encurtador Sink
NUXT_SITE_TOKEN=                        # Token de autenticação da API do Sink (para encurtar links longos do S3)

# ─────────────────────────────────────────────────────────────
# 5.3 Retenção, Quotas, Cache Local e Migração
# ─────────────────────────────────────────────────────────────
S3_RETENTION_DAYS=3                     # Dias para manter arquivos de mídia (lifecycle S3; 0 = desativado)
S3_DOWNLOADS_RETENTION_HOURS=48         # Retenção de downloads temporários em horas
S3_BACKUPS_RETENTION_DAYS=30            # Retenção de backups diários no S3 em dias
S3_STORAGE_LIMIT_GB=30                  # Quota informativa de storage (GB)
S3_LOCAL_CACHE=false                    # false = economiza escritas e desgaste no SSD principal
S3_LOCAL_CACHE_TTL_HOURS=2              # TTL do cache local S3 em horas
S3_LOCAL_CACHE_MAX_MB=500               # Tamanho máximo do cache local S3 em MB
STORAGE_MIGRATION_PATH=/app/downloads/ravena_data_migration # Caminho de fallback para mídias migradas do disco legado

# ─────────────────────────────────────────────────────────────
# 5.4 Retenção e Limpeza de Mídias de Grupos Órfãos (S3 zap-media)
# ─────────────────────────────────────────────────────────────
ORPHAN_MEDIA_CLEANUP_ENABLED=true       # Ativa a limpeza semanal automática de grupos dos quais o bot saiu
ORPHAN_MEDIA_CLEANUP_DRY_RUN=false      # Se true, apenas simula sem deletar objetos
ORPHAN_MEDIA_RETENTION_DAYS=30          # Dias de carência após a saída do bot do grupo
ORPHAN_MEDIA_CLEANUP_CRON="0 4 * * 0"   # Agendamento semanal (domingo 04:00 BRT)


# =============================================================
# 6. DOWNLOADERS DE MÍDIA (Cobalt & YouTube)
# =============================================================
COBALT_PORT=9090                        # Porta do Cobalt exposta no docker-compose
COBALT_API_URL=http://cobalt:9000       # URL interna para o bot acessar a API do Cobalt
COBALT_EXTERNAL_URL=http://localhost:9090 # URL para o bot baixar o túnel/arquivo do Cobalt
YT_USE_COOKIES=false                    # true = usa cookies (data/www.youtube.com_cookies.json) no yt-dlp


# =============================================================
# 7. MINIGAMES E ECOSSISTEMA RAVENA
# =============================================================

# ─────────────────────────────────────────────────────────────
# 7.1 Waifuletes — Roleta de Waifus (Mudae)
# ─────────────────────────────────────────────────────────────
WAIFULETES_API_URL=http://host.docker.internal:3030 # URL da API do Waifuletes
WAIFULETES_API_KEY=                     # Token de autenticação da API do Waifuletes
WAIFULETES_WEB_URL=https://waifuletes.example.com # URL pública do portal web do Waifuletes

# ─────────────────────────────────────────────────────────────
# 7.2 Jardim das Sombras — Minigame de Fazenda Gótica
# ─────────────────────────────────────────────────────────────
JARDIM_API_URL=http://host.docker.internal:3040 # URL da API do Jardim das Sombras
JARDIM_API_KEY=jardim_secret_api_key_2026 # Chave secreta da API da Fazenda

# ─────────────────────────────────────────────────────────────
# 7.3 Ragnarok Online (Banco de dados do servidor, opcional)
# ─────────────────────────────────────────────────────────────
RAGNAROK_URL=
RAGNAROK_HOST=
RAGNAROK_USER=
RAGNAROK_PASSWORD=
RAGNAROK_DATABASE=

# ─────────────────────────────────────────────────────────────
# 7.4 Copa do Mundo 2026 API
# ─────────────────────────────────────────────────────────────
WDC2026_API_URL=https://worldcup26.ir/  # URL da API da Copa 2026 (https://github.com/rezarahiminia/worldcup2026)


# =============================================================
# 8. SERVIÇOS DE IA, IMAGEM E MODERAÇÃO
# Nota: Provedores LLM, Whisper, ComfyUI, Bonsai, SD WebUI, F5-TTS,
#       Laya e NudeNet (endpoints, chaves, thresholds e parâmetros)
#       são configurados em service-providers.json
# =============================================================

# ─────────────────────────────────────────────────────────────
# 8.1 Web Reader / Search & Embeddings
# ─────────────────────────────────────────────────────────────
JINA_API_KEY=                           # https://jina.ai/ (Reader e Search para ferramentas da LLM)
# OLLAMA_EMBED_URL=http://192.168.195.212:11434 # Endpoint Ollama para geração de embeddings (memória)
# OLLAMA_EMBED_MODEL=bge-m3:latest      # Modelo padrão de embeddings

# ─────────────────────────────────────────────────────────────
# 8.2 Remoção de Fundo (rembg — interno Docker)
# ─────────────────────────────────────────────────────────────
REMBG_API_URL=http://rembg:7000/api/remove # URL interna do serviço rembg
# REMBG_MODEL=                          # Modelo customizado opcional para o rembg


# =============================================================
# 9. INTEGRAÇÕES E APIs EXTERNAS
# =============================================================

# ─────────────────────────────────────────────────────────────
# 9.1 Streaming e Música (Twitch, Kick, YouTube, SoundCloud, Last.fm)
# ─────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=                       # https://dev.twitch.tv/docs/api/
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=                         # https://docs.kick.com/getting-started/kick-apps-setup
KICK_CLIENT_SECRET=
# YOUTUBE_API_KEY=                      # Opcional: Chave da YouTube Data API v3 para monitoramento de lives
SOUNDCLOUD_CLIENT_ID=                   # Pegar da aba network no navegador
SOUNDCLOUD_OAUTH_TOKEN=                 # Pegar da aba network no navegador
LASTFM_APIKEY=                          # https://www.last.fm/pt/api
LASTFM_SECRET=

# ─────────────────────────────────────────────────────────────
# 9.2 Jogos e Perfis (Riot Games, Steam, PSN / Platifly)
# ─────────────────────────────────────────────────────────────
RIOT_GAMES=                             # https://developer.riotgames.com/
STEAMCOMMAND_API_URL=                   # URL da API de consulta de platinas Steam
PSNCOMMAND_API_URL=                     # URL da API de consulta de platinas PSN
API_KEY_STEAMCOMMAND=                   # Token Bearer para as APIs de platinas Steam/PSN

# ─────────────────────────────────────────────────────────────
# 9.3 Utilidades, Mídia e Tradução (DeepL, Giphy, OMDb, Unsplash, NASA)
# ─────────────────────────────────────────────────────────────
DEEPL_API_KEY=                          # https://www.deepl.com/pro-api (Opcional - Chave da API DeepL)
GIPHY_API_KEY=                          # https://developers.giphy.com/
OMDB_API_KEY=                           # https://www.omdbapi.com/apikey.aspx
UNSPLASH_API_KEY=                       # https://unsplash.com/developers
NASA_API=                               # https://api.nasa.gov/

# ─────────────────────────────────────────────────────────────
# 9.4 Consultas Veiculares (Placas, FIPE, SIPT) e Correios
# ─────────────────────────────────────────────────────────────
API_PLACAS_COMUM=                       # https://apiplacas.com.br/
API_PLACAS_PREMIUM=                     # https://apiplacas.com.br/
GRUPOS_PLACA_PREMIUM=                   # Nomes de grupos que podem usar a API placa premium (separados por vírgula)
# API_PLACAS_USAR_PREMIUM=TRUE          # Descomente caso tenha chave premium
FIPE_API_TOKEN=                         # https://fipe.online/ (Token [X-Subscription-Token])
SIPT_URL=                               # Endpoint do serviço SIPT para consulta complementar de placas
SIPT_TOKEN=                             # Token (x-sipt-token) do serviço SIPT
CORREIOS_API=                           # URL da API custom para rastreamento dos Correios

# ─────────────────────────────────────────────────────────────
# 9.5 Aviação e Rastreamento de Voos (Opcionais)
# O bot já possui ADS-B ao vivo (adsb.lol + OpenSky), ANAC RAB, hexdb.io e METAR gratuitos sem chave.
# ─────────────────────────────────────────────────────────────
AISWEB_API_KEY=                         # Chave da API AISWEB (DECEA/FAB - aisweb.decea.mil.br)
AISWEB_API_PASS=                        # Senha da API AISWEB (DECEA/FAB)
AIRLABS_API_KEY=                        # Chave AirLabs (airlabs.co - painéis de partidas/chegadas)
AVIATIONSTACK_API_KEY=                  # Chave AviationStack (aviationstack.com)


# =============================================================
# 10. DOAÇÕES (Tipa.ai)
# =============================================================
TIPA_TOKEN=                             # https://tipa.ai/settings/apps (Token para validação de Webhooks)
DONATION_GOAL_AMOUNT=1000               # Valor da meta de doações (R$)
DONATION_GOAL_DESCRIPTION=Pagar o servidor! # Descrição da meta de doações


# =============================================================
# 11. WHATSGOAPI — Configurações do Backend Go (whatsmeow)
# =============================================================

# ─────────────────────────────────────────────────────────────
# 11.1 Servidor e Autenticação
# ─────────────────────────────────────────────────────────────
SERVER_PORT=8080                        # Porta INTERNA em que o whatsgoapi escuta
WHATSGOAPI_PORT=9800                    # Porta EXPOSTA ao host — acesse via localhost:9800
GLOBAL_API_KEY=SUA_GLOBAL_API_KEY       # [REQUIRED] Gerada automaticamente pelo 'make setup'. Compartilhada entre ravena-ai e whatsgoapi.

# ─────────────────────────────────────────────────────────────
# 11.2 Banco de Dados PostgreSQL (whatsgoapi)
# ⚠ Estes valores são usados para CRIAR o banco na primeira execução.
#   Após criado, não altere sem recriar o volume (docker compose down -v).
#   Use POSTGRES_USERS_DB (DSN completo) OU as variáveis separadas abaixo.
# ─────────────────────────────────────────────────────────────
POSTGRES_USERS_DB=                      # DSN completo (opcional): postgresql://user:pass@host:5432/db?sslmode=disable
POSTGRES_HOST=postgres                  # Host do PostgreSQL (não altere em Docker)
POSTGRES_PORT=5432                      # Porta do PostgreSQL
POSTGRES_USER=whatsgo                   # Usuário do PostgreSQL — usado na criação do banco
POSTGRES_PASSWORD=whatsgo_password      # Senha do PostgreSQL — gerada automaticamente pelo 'make setup'
POSTGRES_DB=whatsgo_db                  # Nome do banco de dados — criado automaticamente
POSTGRES_AUTH_DB=                       # DSN do banco de autenticação (opcional)
DATABASE_SAVE_MESSAGES=false            # true = salva mensagens no banco de dados PostgreSQL

# ─────────────────────────────────────────────────────────────
# 11.3 Comportamento e Cache de Grupos
# ─────────────────────────────────────────────────────────────
CLIENT_NAME=ravenawhats                 # Nome do cliente WhatsApp
OS_NAME=Ravena WhatsGo                  # Nome do sistema operacional reportado ao WhatsApp
CONNECT_ON_STARTUP=true                 # true = conecta instâncias salvas na inicialização
WEBHOOK_URL=""                          # URL global de webhook (deixe vazio para usar webhooks por instância)
WEBHOOK_FILES=false                     # false = desativa download síncrono de mídias no webhook (Ravena baixa sob demanda)
FETCH_GROUP_INFO_ON_MESSAGE=false       # false = NÃO consulta GetGroupInfo no WhatsApp a cada mensagem recebida (evita gargalo)
GROUP_INFO_CACHE_TTL_MIN=30             # TTL em minutos do cache em memória para GetGroupInfo
# CHECK_USER_EXISTS=true                # Verifica existência do número no WhatsApp antes do envio
# QRCODE_MAX_COUNT=5                    # Tentativas máximas de geração de QR Code antes de expirar
# EVENT_IGNORE_GROUP=false              # true = ignora eventos de mensagens em grupos
# EVENT_IGNORE_STATUS=false             # true = ignora eventos de status/stories

# ─────────────────────────────────────────────────────────────
# 11.4 Logs e Diagnóstico (whatsgoapi)
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                          # Nível de log da whatsgoapi: DEBUG, INFO, WARN, ERROR
LOG_TYPE=console                        # Tipo de log: console ou file
DEBUG_ENABLED=                          # 1 = ativa modo de desenvolvimento nos logs de configuração (ou nível de debug do whatsmeow)
LOG_MESSAGE_DETAILS=false               # false = logs compactos de mensagens; true = loga payload completo
LOG_SUMMARY_INTERVAL_SEC=15             # Intervalo em segundos para resumo periódico de mensagens e webhooks (0 = desativado)
LOG_MAX_SIZE=100                        # Tamanho máximo do arquivo de log (MB)
LOG_MAX_BACKUPS=5                       # Número máximo de backups de log
LOG_MAX_AGE=30                          # Dias para manter logs
LOG_DIRECTORY=./logs                    # Diretório de logs
LOG_COMPRESS=true                       # true = comprime logs antigos


# =============================================================
# 12. HEALTH CHECK — Monitoramento de Containers e Disco
# Usado pelo container health-check para monitorar whatsgoapi, ravena-ai, RAM e disco
# =============================================================

# ─────────────────────────────────────────────────────────────
# 12.1 Intervalo e Notificações via Telegram
# ─────────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=60                # Intervalo em segundos entre as verificações de saúde
HEALTH_CHECK_TELEGRAM_BOT_TOKEN=        # Token do bot Telegram para notificações de saúde
HEALTH_CHECK_TELEGRAM_CHAT_ID=          # Chat ID do Telegram para receber as notificações

# ─────────────────────────────────────────────────────────────
# 12.2 Monitoramento de Disco e Alertas via WhatsApp
# ─────────────────────────────────────────────────────────────
HEALTH_CHECK_DISK_MOUNT=/               # Partição/ponto de montagem monitorado no container
HEALTH_CHECK_DISK_CRITICAL=95           # % de uso de disco crítica para desligar os containers com segurança
HEALTH_CHECK_DISK_RECOVER=90            # % de uso de disco segura para religar a stack automaticamente
HEALTH_CHECK_DISK_MONITOR_INTERVAL=120  # Intervalo em segundos de checagem quando em modo recovery de disco
HEALTH_CHECK_WA_BOT_INSTANCE=ravenavip  # Instância do whatsgoapi usada para enviar alertas de disco no WhatsApp
HEALTH_CHECK_WA_GROUP=                  # ID do grupo de WhatsApp para alertas críticos de disco (fallback: GRUPO_ANUNCIOS)
