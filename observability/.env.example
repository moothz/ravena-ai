# Copie para observability/.env (fora do git) e ajuste. Lido por:
#   docker compose -f observability/docker-compose.yml up -d

# Obrigatória: senha do admin do Grafana (o compose não sobe sem ela).
# Gere com: openssl rand -base64 24
# Atenção: só vale na primeira subida (volume grafana-data novo). Para trocar depois:
#   docker exec obs-grafana grafana cli admin reset-admin-password <nova>
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_ADMIN_USER=admin

# Endereço em que o collector recebe OTLP/HTTP (porta 4318).
# Linux nativo (servidor): 172.17.0.1 (gateway da docker0; só os containers alcançam).
# Docker Desktop: deixe comentado (padrão 127.0.0.1). Nunca 0.0.0.0.
# OTEL_BIND_ADDR=172.17.0.1

# Retenção (os traces têm telefone/ID; menos tempo = menos dado pessoal guardado)
# JAEGER_RETENTION=168h
# PROMETHEUS_RETENTION=15d
# PROMETHEUS_RETENTION_SIZE=2GB
# PROMETHEUS_PORT=9091

# Painel da economia (OBSERVABILITY.md): caminho NO HOST do analytics.db que a ravena-ai grava
# (ECONOMY_ANALYTICS_DB no .env da raiz). Relativo a observability/. Padrão: ../data/sqlites/analytics.db
# O arquivo precisa existir antes do `up` (senão o Docker cria um diretório no lugar): ligue a carga
# e espere a primeira rodada (minuto 5) antes de subir o Grafana.
# ECONOMY_ANALYTICS_DB_HOST=../data/sqlites/analytics.db
