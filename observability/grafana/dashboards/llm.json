     },
     "expr": "label_replace(sum by (gen_ai_provider_name) (increase(traces_span_metrics_calls_total{service_name=\"ravena-ai\",span_kind=\"SPAN_KIND_CLIENT\",span_name=~\"chat .*\",gen_ai_request_model=~\"$modelo\"}[1h])), \"gen_ai_provider_name\", \"sem provedor (collector sem a dimensão)\", \"gen_ai_provider_name\", \"\")",
