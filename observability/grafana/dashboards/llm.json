  {
   "id": 13,
   "type": "table",
   "title": "Por modelo no período",
   "description": "Chamadas, falhas (status ERROR no span do provedor) e latência p95 da chamada, por modelo, no período do seletor.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
