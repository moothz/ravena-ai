{
 "uid": "ravena-red",
 "title": "Ravena — RED e gargalos",
 "tags": [
  "ravena",
  "otel"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 2,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "links": [
  {
   "title": "Abrir traces no Jaeger",
   "url": "http://localhost:16686/search",
   "type": "link",
   "targetBlank": true,
   "icon": "external link"
  }
 ],
 "templating": {
  "list": [
   {
    "name": "service",
    "label": "Serviço",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(traces_span_metrics_calls_total, service_name)",
     "refId": "A"
    },
    "definition": "label_values(traces_span_metrics_calls_total, service_name)",
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*",
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Visão geral por serviço (RED)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Taxa de requisições (spans SERVER/CONSUMER) /s",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[$__rate_interval]))",
     "legendFormat": "{{service_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Erros (status ERROR) /s",
   "description": "Só SERVER/CONSUMER/INTERNAL: spans CLIENT marcam 4xx de negócio como erro (semconv HTTP) e inflariam a taxa.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER|SPAN_KIND_INTERNAL\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
     "legendFormat": "{{service_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "p95 de duração (SERVER/CONSUMER)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\",span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[$__rate_interval])))",
     "legendFormat": "{{service_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ]
    }
   }
  },
