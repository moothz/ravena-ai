     "calcs": [
      "mean",
      "max"
     ]
    }
   }
  },
  {
   "id": 7,
   "type": "table",
   "title": "Top rotas por tempo total consumido (ms de CPU/espera por s)",
   "description": "Onde o tempo vai: taxa × latência. Use o intervalo do dashboard.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(15, sum by (service_name, span_name) (rate(traces_span_metrics_duration_milliseconds_sum{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__range])))",
     "legendFormat": "__auto",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "suffix:ms/s",
     "decimals": 3
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "Tempo consumido",
      "desc": true
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "Time": 0,
       "service_name": 1,
       "span_name": 2
      },
      "renameByName": {
       "service_name": "Serviço",
       "span_name": "Operação",
       "Value": "Tempo consumido"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "sort": [
       {
        "field": "Tempo consumido",
        "desc": true
       }
      ]
     }
    }
   ]
  },
