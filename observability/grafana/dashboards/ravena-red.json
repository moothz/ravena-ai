      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, service_name, span_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
     "legendFormat": "{{service_name}} {{span_name}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
